        oracledb.init_oracle_client(lib_dir=ORACLE_CLIENT_DIR)
        log.info("Oracle client initialized")
    except Exception as e:
        log.error(f"Oracle client init failed: {e}"); raise

def get_conn(retries=3):
    for i in range(1, retries + 1):
        try:
            log.info(f"Connecting to Oracle (attempt {i}/{retries})...")
            conn = oracledb.connect(user=USERNAME, password=PASSWORD, dsn=DSN)
            with conn.cursor() as cur:
                cur.execute("ALTER SESSION SET CURRENT_SCHEMA = APPS")
            log.info("Connected.")
            return conn
        except oracledb.DatabaseError as e:
            if i == retries: raise
            log.warning(f"Attempt {i} failed, retrying...")

def run_query(conn, sql, params=None, chunk=5000):
    chunks = []
    with conn.cursor() as cur:
        cur.arraysize = chunk
        cur.execute(sql, params or {})
        cols = [d[0].upper() for d in cur.description]
        while True:
            rows = cur.fetchmany(chunk)
            if not rows: break
            chunks.append(pd.DataFrame(rows, columns=cols))
    return pd.concat(chunks, ignore_index=True) if chunks else pd.DataFrame(columns=cols)


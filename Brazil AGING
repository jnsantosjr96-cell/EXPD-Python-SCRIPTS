# WORKBOOK HELPERS
# ============================================================
def df_to_sheet(df, ws, header_bg=C_DARK, freeze=True):
    """Write a DataFrame to a worksheet with formatted headers."""
    if df.empty:
        ws.append(list(df.columns))
        return

    # Headers
    for col_idx, col_name in enumerate(df.columns, start=1):
        c = ws.cell(1, col_idx, col_name)
        hdr(c, bg=header_bg, size=9)
        # Auto-width estimate
        ws.column_dimensions[get_column_letter(col_idx)].width = max(
            min(len(str(col_name)) + 4, 40), 10)

    # Data
    num_cols = df.select_dtypes(include='number').columns.tolist()
    date_cols = df.select_dtypes(include=['datetime64']).columns.tolist()

    for row_idx, row in enumerate(df.itertuples(index=False), start=2):
        for col_idx, (col_name, val) in enumerate(zip(df.columns, row), start=1):
            c = ws.cell(row_idx, col_idx)
            # Convert numpy types
            if hasattr(val, 'item'):
                val = val.item()
            if pd.isna(val) if not isinstance(val, (str, datetime, date)) else False:
                val = None
            c.value = val
            c.font = font(size=9)
            c.border = border("hair")
            c.alignment = Alignment(horizontal="left", vertical="center")
            if col_name in num_cols and val is not None:
                c.number_format = NUM_BRL_NEG
                c.alignment = Alignment(horizontal="right", vertical="center")
            if col_name in date_cols and val is not None:
                c.number_format = "DD/MM/YYYY"

    if freeze:
        ws.freeze_panes = ws.cell(2, 1)
    ws.sheet_view.showGridLines = False



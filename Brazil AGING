def _get_cm_nums(df_trans):
    """Extract credited INV numbers and rebilled INV numbers from REBILL-OWNERSHIP CHANGE CMs."""
    df = df_trans.copy()
    df.columns = [c.upper().strip() for c in df.columns]

    cms = df[
        (df["CLASS"] == "CM") &
        (df["REASON CODE"] == "REBILL-OWNERSHIP CHANGE") &
        (~df["TRX TYPE NAME"].str.contains("RELO", na=False))
    ]

    # Extract credited INV numbers from CM Reference field
    credited_nums = set()
    for _, row in cms.iterrows():
        ref = str(row.get("REFERENCE", "") or "")
        m = re.search(r'CREDIT INVOICE (\d+)', ref)
        if m:
            credited_nums.add(int(m.group(1)))

    rebilled_nums = set()
    if credited_nums:
        credited_rows = df[
            (df["CLASS"] == "INV") &
            (df["TRANSACTION NUMBER"].astype(str).isin([str(n) for n in credited_nums]))
        ]

        # Build match keys: (account_number_str, rounded_abs_amount)
        # Use round(2) to avoid float precision mismatches from Oracle Decimal
        keys = set()
        for _, r in credited_rows.iterrows():
            acct = str(r["ACCOUNT NUMBER"]).strip()
            try:
                amt_key = round(float(abs(r["ENTERED AMT"] or 0)), 2)
            except (TypeError, ValueError):
                continue
            keys.add((acct, amt_key))

        log.info(f"  Match keys for rebill lookup: {keys}")

        # Warn if any credited INV is itself a BR_DIR_INV_REBILL
        # These are still valid rebills — include them as rebill candidates too
        for _, r in credited_rows.iterrows():
            if str(r.get("TRX TYPE NAME", "")).strip() == "BR_DIR_INV_REBILL":
                log.warning(
                    f"  INV {r['TRANSACTION NUMBER']} is itself a BR_DIR_INV_REBILL "
                    f"(hotel {r['ACCOUNT NUMBER']}, amt {r['ENTERED AMT']}) — "
                    f"including as rebill in Rebilled section"
                )
                rebilled_nums.add(int(r["TRANSACTION NUMBER"]))

        # Find BR_DIR_INV_REBILL candidates in df_trans
        rebill_candidates = df[
            (df["CLASS"] == "INV") &
            (df["TRX TYPE NAME"] == "BR_DIR_INV_REBILL")
        ]
        log.info(f"  BR_DIR_INV_REBILL rows in period: {len(rebill_candidates)}")

        for _, r in rebill_candidates.iterrows():
            acct = str(r["ACCOUNT NUMBER"]).strip()
            try:
                amt_key = round(float(abs(r["ENTERED AMT"] or 0)), 2)
            except (TypeError, ValueError):
                continue
            if (acct, amt_key) in keys:
                rebilled_nums.add(int(r["TRANSACTION NUMBER"]))

    return cms, credited_nums, rebilled_nums


def write_rebilled_inv(ws, df_trans, df_credited, df_rebilled, cms_df):
    """
    Populate the Rebilled Inv sheet with three sections:
      1. CREDIT MEMOS         — from cms_df (BR Trans schema, TRX_COLS_CM)
      2. CREDITED INVOICES    — from df_credited (TRX Detail schema, TRX_COLS_DETAIL)
      3. REBILLED INVOICES    — from df_rebilled (TRX Detail schema, TRX_COLS_DETAIL)
    """
    ws.sheet_view.showGridLines = False

    # Set column widths based on the wider detail schema
    detail_widths = [16,12,28,26,10,10,8,14,18,22,30,14,12,12,14,
                     14,14,14,14,14,20,30,60,20,24,16,16,10,12,14,
                     14,14,12,14,16,24,12,10]
    for i, w in enumerate(detail_widths, 1):
        ws.column_dimensions[get_column_letter(i)].width = w

    if df_trans.empty:
        ws.cell(1, 1, "No data available for this period.")
        return

    # Normalize cms_df columns
    cms_df = cms_df.copy()
    cms_df.columns = [c.upper().strip() for c in cms_df.columns]

    row_idx = [1]
    n_cm_cols     = len(TRX_COLS_CM)
    n_detail_cols = len(TRX_COLS_DETAIL)

    def section_hdr(title, bg, n_cols):
        ws.merge_cells(f"A{row_idx[0]}:{get_column_letter(n_cols)}{row_idx[0]}")
        c = ws.cell(row_idx[0], 1, title)
        c.fill = fill(bg); c.font = font(bold=True, size=11)
        c.alignment = Alignment(horizontal="left", vertical="center")
        c.border = border("medium"); row_idx[0] += 1

    def col_hdrs(cols, bg=C_MID):
        for ci, lbl in enumerate(cols, 1):
            hdr(ws.cell(row_idx[0], ci, lbl), bg=bg, size=9)
        row_idx[0] += 1

    def data_rows(src_df, cols, amt_cols):
        if src_df is None or src_df.empty:
            row_idx[0] += 1   # blank row placeholder
            return
        src_upper = src_df.copy()
        src_upper.columns = [c.upper().strip() for c in src_upper.columns]

        for _, row in src_upper.iterrows():
            for ci, col_lbl in enumerate(cols, 1):
                val = row.get(col_lbl.upper())
                if hasattr(val, 'item'): val = val.item()
                if val is not None and not isinstance(val, (str, datetime, date)):
                    try:
                        if pd.isna(val): val = None
                    except: pass
                c = ws.cell(row_idx[0], ci, val)
                c.font = font(size=9); c.border = border("hair")
                c.alignment = Alignment(horizontal="left", vertical="center")
                if ci in amt_cols and val is not None:
                    c.number_format = NUM_BRL_NEG
                    c.alignment = Alignment(horizontal="right", vertical="center")
            row_idx[0] += 1

        # Totals row
        ws.merge_cells(f"A{row_idx[0]}:M{row_idx[0]}")
        c = ws.cell(row_idx[0], 1, "TOTAL")
        c.font = font(bold=True, size=9); c.fill = fill(C_GREEN)
        c.border = border(); c.alignment = Alignment(horizontal="right")
        # Entered Amt and USD Amount totals
        for col_lbl in ["ENTERED AMT", "USD AMOUNT"]:
            if col_lbl in src_upper.columns:
                ci = next((i+1 for i, h in enumerate(cols) if h.upper() == col_lbl), None)
                if ci:
                    total = float(src_upper[col_lbl].sum())
                    c2 = ws.cell(row_idx[0], ci, total)
                    c2.font = font(bold=True, size=9); c2.fill = fill(C_GREEN)
                    c2.border = border(); c2.number_format = NUM_BRL
                    c2.alignment = Alignment(horizontal="right")
        row_idx[0] += 1

    # ── Section 1: CREDIT MEMOS ───────────────────────────
    section_hdr("CREDIT MEMOS — REBILL-OWNERSHIP CHANGE", C_CM, n_cm_cols)
    col_hdrs(TRX_COLS_CM)
    data_rows(cms_df, TRX_COLS_CM, CM_AMT_COLS)
    row_idx[0] += 1

    # ── Section 2: CREDITED INVOICES ──────────────────────
    section_hdr("CREDITED INVOICES (original invoices being credited)", C_INV, n_detail_cols)
    col_hdrs(TRX_COLS_DETAIL)
    data_rows(df_credited, TRX_COLS_DETAIL, DETAIL_AMT_COLS)
    row_idx[0] += 1

    # ── Section 3: REBILLED INVOICES ──────────────────────
    section_hdr(
        "REBILLED INVOICES — BR_DIR_INV_REBILL (substitutes, most recent first)",
        C_REBILL, n_detail_cols)
    col_hdrs(TRX_COLS_DETAIL)
    # Sort by TRX DATE desc if column exists
    if df_rebilled is not None and not df_rebilled.empty:
        df_reb_sorted = df_rebilled.copy()
        df_reb_sorted.columns = [c.upper().strip() for c in df_reb_sorted.columns]
        if "TRX DATE" in df_reb_sorted.columns:
            df_reb_sorted = df_reb_sorted.sort_values("TRX DATE", ascending=False)
        data_rows(df_reb_sorted, TRX_COLS_DETAIL, DETAIL_AMT_COLS)
    else:
        row_idx[0] += 1
    row_idx[0] += 1

    # Footer note
    ws.merge_cells(f"A{row_idx[0]}:H{row_idx[0]}")
    ws.cell(row_idx[0], 1,
        "NOTE: CMs referencing a DEBIT MEMO (e.g. CM 263000649) are included in the "
        "Credit Memos section but have no corresponding INV in the sections below."
    ).font = font(italic=True, size=8, color="888888")



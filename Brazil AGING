# ── 4. AR Aging 7 Buckets ────────────────────────────────────
SQL_AGING = f"""
WITH params AS (
    SELECT
        DATE '{AS_OF_DATE}'  AS as_of_date,
        '{PERIOD_NAME}'      AS period_name,
        'Brazil PL'          AS ledger_name,
        222                  AS ar_app_id
    FROM dual
),
ledger AS (
    SELECT L.LEDGER_ID
    FROM   GL.GL_LEDGERS L, params P
    WHERE  L.NAME = P.ledger_name
),
fx_rate AS (
    SELECT NVL(
        (SELECT r.conversion_rate FROM gl.gl_daily_rates r, params P
         WHERE r.from_currency='USD' AND r.to_currency='BRL'
           AND r.conversion_type='Corporate'
           AND r.conversion_date=TRUNC(P.as_of_date) AND ROWNUM=1),
        (SELECT r.conversion_rate FROM gl.gl_daily_rates r, params P
         WHERE r.from_currency='USD' AND r.to_currency='BRL'
           AND r.conversion_type='Corporate'
           AND r.conversion_date=(
               SELECT MAX(r2.conversion_date) FROM gl.gl_daily_rates r2, params p2
               WHERE r2.from_currency='USD' AND r2.to_currency='BRL'
                 AND r2.conversion_type='Corporate'
                 AND r2.conversion_date < TRUNC(p2.as_of_date))
           AND ROWNUM=1)
    ) AS usd_brl_rate
    FROM dual
),
ar_inv_dm_cm AS (
    SELECT 'Brazil PL' AS ledger, '11115' AS company,
        GCC.SEGMENT2 AS account, HZP.PARTY_NAME AS customer,
        HCA.ACCOUNT_NUMBER AS bill_to_number,
        NVL(HCA.CUSTOMER_CLASS_CODE,'HOTEL') AS partner_category,
        CTTA.NAME AS transaction_type,
        CASE PSA.CLASS WHEN 'INV' THEN 'Invoice'
            WHEN 'DM' THEN 'Debit Memo' WHEN 'CM' THEN 'Credit Memo'
            ELSE PSA.CLASS END AS transaction_class,
        CTA.TRX_NUMBER AS transaction_num,
        CTA.TRX_DATE AS transaction_date,
        NVL((SELECT T.TERRITORY_SHORT_NAME FROM APPS.FND_TERRITORIES_VL T
             WHERE T.TERRITORY_CODE=HZP.COUNTRY AND ROWNUM=1), HZP.COUNTRY) AS bill_to_country,
        PSA.DUE_DATE,
        PSA.INVOICE_CURRENCY_CODE AS transactional_currency,
        CASE WHEN PSA.STATUS='CL' THEN PSA.AMOUNT_DUE_ORIGINAL
             ELSE PSA.AMOUNT_DUE_REMAINING END AS transactional_outstanding_amount,
        GREATEST(TRUNC(P.AS_OF_DATE)-TRUNC(PSA.DUE_DATE),0) AS days_past_due,
        NVL(PSA.ACCTD_AMOUNT_DUE_REMAINING,PSA.AMOUNT_DUE_ORIGINAL) AS outstanding_func,
        HCA.ATTRIBUTE1 AS hotel_id,
        DECODE(HCA.STATUS,'A','Active','I','Inactive',HCA.STATUS) AS account_status,
        'No Sales Credit' AS salesperson,
        P.AS_OF_DATE, FX.USD_BRL_RATE
    FROM AR.RA_CUSTOMER_TRX_ALL CTA
        JOIN params P ON 1=1 JOIN fx_rate FX ON 1=1 JOIN ledger L ON 1=1
        JOIN AR.AR_PAYMENT_SCHEDULES_ALL PSA ON PSA.CUSTOMER_TRX_ID=CTA.CUSTOMER_TRX_ID
        JOIN AR.RA_CUST_TRX_TYPES_ALL CTTA ON CTTA.CUST_TRX_TYPE_ID=CTA.CUST_TRX_TYPE_ID
        LEFT JOIN AR.HZ_CUST_ACCOUNTS HCA ON HCA.CUST_ACCOUNT_ID=CTA.BILL_TO_CUSTOMER_ID
        LEFT JOIN AR.HZ_PARTIES HZP ON HZP.PARTY_ID=HCA.PARTY_ID
        LEFT JOIN (
            SELECT RGL2.CUSTOMER_TRX_ID, MIN(GCC2.SEGMENT2) AS SEGMENT2
            FROM AR.RA_CUST_TRX_LINE_GL_DIST_ALL RGL2

def run_trx_detail(conn, trx_numbers):
    """
    Run SQL_TRX_DETAIL for a set of transaction numbers.
    CTA.TRX_NUMBER is VARCHAR2 in Oracle EBS — pass as quoted string literals.
    Splits into batches of 999 to respect Oracle IN clause limit.
    """
    if not trx_numbers:
        return pd.DataFrame()

    # Validate: must be numeric strings only (no injection risk)
    validated = [str(int(n)) for n in trx_numbers]
    results = []

    for i in range(0, len(validated), 999):
        chunk   = validated[i:i + 999]
        in_list = ",".join(f"'{v}'" for v in chunk)   # quoted strings for VARCHAR2
        sql     = SQL_TRX_DETAIL.format(trx_in=in_list)
        df      = run_query(conn, sql)
        results.append(df)

    return pd.concat(results, ignore_index=True) if results else pd.DataFrame()



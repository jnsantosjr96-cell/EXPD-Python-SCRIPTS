def write_summary(ws, df_trans, df_adj, df_gl):
    ws.sheet_view.showGridLines = False
    for col, w in [("A",18),("B",20),("C",4),("D",20),("E",20),
                   ("F",4),("G",4),("H",40),("I",22),
                   ("J",18),("K",14),("L",14),("M",14)]:
        ws.column_dimensions[col].width = w

    # Pivot HC
    hc = df_trans.groupby("CLASS")["ENTERED AMT"].sum().to_dict() if not df_trans.empty else {}
    # Pivot GL by Journal Category
    gl = df_gl.groupby("JOURNAL_CATEGORY")["ENTERED_AMT"].sum().to_dict() if not df_gl.empty else {}
    # Pivot ADJ by NAME
    adj = df_adj.groupby("NAME")["ENTERED AMOUNT"].sum().to_dict() if not df_adj.empty else {}

    # ── LEFT: EXPD HC ──────────────────────────────────────
    r = 1
    ws.merge_cells(f"A{r}:B{r}")
    hdr(ws.cell(r, 1, "EXPD HC Transactions"), bg=C_DARK)
    ws.cell(r, 2).fill = fill(C_DARK)
    r += 1
    hdr(ws.cell(r, 1, "Row Labels"), bg=C_MID, size=9)
    hdr(ws.cell(r, 2, "Sum of Entered Amt"), bg=C_MID, size=9)
    r += 1
    hc_rows = [("CM", hc.get("CM", 0.0)), ("DM", hc.get("DM", 0.0)), ("INV", hc.get("INV", 0.0))]
    for lbl, val in hc_rows:
        ws.cell(r, 1, lbl).font = font(); ws.cell(r, 1).border = border("hair")
        ws.cell(r, 1).fill = fill(C_GREY)
        amt(ws.cell(r, 2), val); r += 1
    ws.cell(r, 1, "Grand Total").font = font(bold=True)
    ws.cell(r, 1).fill = fill(C_GREEN); ws.cell(r, 1).border = border()
    c = ws.cell(r, 2, sum(v for _, v in hc_rows))
    c.number_format = NUM_BRL; c.font = font(bold=True)
    c.fill = fill(C_GREEN); c.border = border()
    c.alignment = Alignment(horizontal="right")

    # ── LEFT: Adjustment sub-table ─────────────────────────
    r += 2
    ws.merge_cells(f"A{r}:B{r}")
    hdr(ws.cell(r, 1, "Adjustment"), bg=C_DARK)
    ws.cell(r, 2).fill = fill(C_DARK)
    r += 1
    hdr(ws.cell(r, 1, "Row Labels"), bg=C_MID, size=9)
    hdr(ws.cell(r, 2, "Sum of Entered Amount"), bg=C_MID, size=9)
    r += 1
    for name, val in sorted(adj.items()):
        ws.cell(r, 1, name).font = font(); ws.cell(r, 1).border = border("hair")
        ws.cell(r, 1).fill = fill(C_GREY)
        amt(ws.cell(r, 2), val); r += 1
    ws.cell(r, 1, "Grand Total").font = font(bold=True)
    ws.cell(r, 1).fill = fill(C_GREEN); ws.cell(r, 1).border = border()
    c = ws.cell(r, 2, sum(adj.values()) if adj else 0.0)
    c.number_format = NUM_BRL; c.font = font(bold=True)

def main():
    log.info("=" * 60)
    log.info("Brazil MXM Closing Workbook Builder — FULL INTEGRATED")
    log.info(f"  Period   : {PERIOD_NAME}  ({PERIOD_LABEL})")
    log.info(f"  Dates    : {PERIOD_START_ORACLE} → {PERIOD_END_ORACLE}")
    log.info(f"  As-of    : {AS_OF_DATE}")
    log.info(f"  Output   : {OUTPUT_FILE}")
    log.info("=" * 60)

    init_oracle()
    conn = get_conn()

    try:
        # ── 1. GL Subledger ────────────────────────────────
        log.info("Running GL Subledger query...")
        df_gl = run_query(conn, SQL_GL, {
            "ar_app_id":   AR_APP_ID,
            "ledger_name": LEDGER,
            "period_name": PERIOD_NAME,
            "company":     COMPANY,
        })
        log.info(f"  GL rows: {len(df_gl):,}")
        for cat, cnt in df_gl["JOURNAL_CATEGORY"].value_counts().items():
            log.info(f"    {cat}: {cnt:,}")

        # ── 2. Brazil Transactions ─────────────────────────
        log.info("Running Brazil Transactions query...")
        df_trans = run_query(conn, SQL_TRANS, {
            "period_start": PERIOD_START_ORACLE,
            "period_end":   PERIOD_END_ORACLE,
        })
        log.info(f"  Transactions rows: {len(df_trans):,}")
        for cls, cnt in df_trans["CLASS"].value_counts().items():
            log.info(f"    {cls}: {cnt:,}")

        # ── 3. Brazil Adjustments ──────────────────────────
        log.info("Running Adjustments query...")
        df_adj = run_query(conn, SQL_ADJ, {
            "adj_start": PERIOD_START_4Y,
            "adj_end":   PERIOD_END_4Y,
        })
        log.info(f"  Adjustment rows: {len(df_adj):,}")

        # ── 4. AR Aging 7 Buckets ──────────────────────────
        log.info("Running AR Aging 7 Buckets query...")
        df_aging = run_query(conn, SQL_AGING)
        log.info(f"  Aging rows: {len(df_aging):,}")

        # ── 5. TRX Detail for Credited + Rebilled INVs ─────
        log.info("Extracting rebill transaction numbers from BR Transactions...")
        cms_df, credited_nums, rebilled_nums = _get_cm_nums(df_trans)
        log.info(f"  Credited INV numbers : {sorted(credited_nums)}")
        log.info(f"  Rebilled INV numbers : {sorted(rebilled_nums)}")

        df_credited = pd.DataFrame()
        df_rebilled = pd.DataFrame()

        if credited_nums:
            log.info(f"  Running TRX Detail for {len(credited_nums)} credited invoice(s)...")
            df_credited = run_trx_detail(conn, credited_nums)
            log.info(f"  Credited INV rows: {len(df_credited):,}")

            # Any credited INV that is itself a BR_DIR_INV_REBILL should also
            # appear in the Rebilled section (e.g. INV 661526, GL_DATE in prior period)
            if not df_credited.empty:
                df_cred_upper = df_credited.copy()
                df_cred_upper.columns = [c.upper().strip() for c in df_cred_upper.columns]
                self_rebills = df_cred_upper[
                    df_cred_upper["TRX TYPE NAME"] == "BR_DIR_INV_REBILL"
                ]["TRANSACTION NUMBER"].tolist()
                if self_rebills:
                    log.info(f"  Credited INVs that are themselves rebills: {self_rebills} — adding to rebilled set")
                    rebilled_nums.update(int(n) for n in self_rebills)

        if rebilled_nums:
            log.info(f"  Running TRX Detail for {len(rebilled_nums)} rebilled invoice(s)...")
            df_rebilled = run_trx_detail(conn, rebilled_nums)
            log.info(f"  Rebilled INV rows: {len(df_rebilled):,}")

    except oracledb.DatabaseError as e:
        log.error(f"Oracle error: {e}"); sys.exit(1)
    finally:
        conn.close()
        log.info("Oracle connection closed.")

    # ── Build Workbook ─────────────────────────────────────
    log.info("Building workbook...")
    wb = Workbook()

    # 1. Summary
    ws_summary = wb.active
    ws_summary.title = "Summary"
    write_summary(ws_summary, df_trans, df_adj, df_gl)
    log.info("  Summary written.")

    # 2. GL with Subledger Detail
    ws_gl = wb.create_sheet("GL with Subledger Detail")
    df_to_sheet(df_gl, ws_gl)
    log.info("  GL with Subledger Detail written.")

    # 3. Brazil Adjustment
    ws_adj = wb.create_sheet("Brazil Adjustment")
    df_to_sheet(df_adj, ws_adj)
    log.info("  Brazil Adjustment written.")

    # 4. Brazil Transactions from period
    ws_trans = wb.create_sheet("Brazil Transactions from period")
    df_to_sheet(df_trans, ws_trans)
    log.info("  Brazil Transactions from period written.")

    # 5. Aging List Updated
    ws_aging = wb.create_sheet("Aging List Updated")
    write_aging_sheet(ws_aging, df_aging)
    log.info("  Aging List Updated written.")

    # 6. SP GovUpdated (manual)
    ws_sp = wb.create_sheet("SP GovUpdated")
    write_sp_gov_placeholder(ws_sp)
    log.info("  SP GovUpdated placeholder written.")

    # 7. Rebilled Inv
    ws_rebill = wb.create_sheet("Rebilled Inv")
    write_rebilled_inv(ws_rebill, df_trans, df_credited, df_rebilled, cms_df)
    log.info("  Rebilled Inv written.")

    # Save
    OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)
    wb.save(str(OUTPUT_FILE))
    log.info(f"Saved: {OUTPUT_FILE}")

    # ── Validation Summary ─────────────────────────────────
    log.info("=" * 60)
    log.info("VALIDATION SUMMARY")
    if not df_trans.empty:
        for cls in ["CM","DM","INV"]:
            v = df_trans[df_trans["CLASS"] == cls]["ENTERED AMT"].sum()
            log.info(f"  HC {cls}: {v:>15,.2f}")
    if not df_gl.empty:
        for cat in ["Credit Memos","Debit Memos","Sales Invoices","Adjustment"]:
            v = df_gl[df_gl["JOURNAL_CATEGORY"] == cat]["ENTERED_AMT"].sum()
            log.info(f"  GL {cat}: {v:>15,.2f}")
    if not df_adj.empty:
        log.info(f"  ADJ total: {df_adj['ENTERED AMOUNT'].sum():>15,.2f}")
    log.info("=" * 60)
    log.info("DONE")
    log.info(f"Output: {OUTPUT_FILE}")
    log.info("=" * 60)


if __name__ == "__main__":
    main()
